# Base URL for the proxy
BASE_URL=http://localhost:8445

# Keycloak configuration
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_DOMAIN=localhost # optional, For using a public url
KEYCLOAK_REALM=proxy-smart

# FHIR server configuration
FHIR_SERVER_BASE=https://hapi.fhir.org/baseR4,https://server.fire.ly
FHIR_SUPPORTED_VERSIONS=STU3, R4, R5

# Optional: Custom port (defaults to 8445)
PORT=8445

# --- AI ----------------------------------------------------------------------
# Two ways to reach a model. The gateway is preferred: it meters usage, holds the
# provider keys, and bills them, so a direct call is invisible to the ledger.
# Configure both and the direct key becomes the fallback for when the gateway is
# unreachable. Configure neither and the AI routes return 503.

# Direct provider key. Get one from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Model used for document import and the patient scribe.
AI_MODEL=gpt-5.4

# LLM Gateway — an OpenAI-compatible proxy (see Max-Health-Inc/llm-gateway).
AI_GATEWAY_URL=https://llm-gateway.maxhealth.tech

# Keycloak client this proxy authenticates to the gateway AS. A SERVICE ACCOUNT,
# deliberately: the gateway meters against the token's `sub`, so forwarding a
# patient's SMART token would make every patient a separate tenant with a
# separate wallet to fund before their first import could run.
AI_GATEWAY_CLIENT_ID=llm-gateway
AI_GATEWAY_CLIENT_SECRET=
AI_GATEWAY_SCOPE=openid

# NOTE: document import and the patient scribe additionally need
# @max-health-inc/connect-engine, an optional (private) dependency. Without it
# those routes report themselves unconfigured; everything else runs unchanged.

