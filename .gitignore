**/node_modules
**/.env
**/dist
**/build
**/__pycache__
.vscode

/backend/public/webapp
/backend/public/apps/*
!/backend/public/apps/index.html

# FHIR cache in sub-apps
**/.cache

# Planning notes
/notes

# OpenAPI Generator Cache
.openapi-generator/

# OpenAPI Generator auto-generated files we don't want
**/generated
# Generated OpenAPI clients. Scoped to the emit directories so
# packages/api-client (the published package itself) stays tracked.
**/src/api-client
**/src/lib/api-client
packages/api-client/src/generated
**/generated_mcp
**/generated_openapi
**/openapi.json
**openapitools.json
**/.venv
**/.pytest_cache
**/.mypy_cache

# AI Tools Cache
.ai_tools_cache/

# AI Sandboxes
.ai_sandboxes/

# Runtime config files
mcp-endpoint.json

# Build and test log files
*-build.log
*-test.log
test-results-new/
test-results-latest/

# VitePress cache
docs/.vitepress/cache
docs/.vitepress/dist

# TypeScript build info
*.tsbuildinfo

# DICOM data files
*.dcm
!scripts/seed/dicom/*.dcm

backend/test_output.txt

# FHIR IG build outputs (keep input/fsh source)
fhir/fsh-generated/
fhir/output/
fhir/temp/
fhir/.cache/
fhir/maxhealth.consent-*.tgz
# Consent IG is consumed as the published @max-health-inc/consent-fhir, not vendored.
lib/maxhealth.consent-*.tgz
# Generated by scripts/check-doc-examples.mjs
.doccheck/

# SMART compliance reports are CI artifacts published to Pages, not commits
# (see smart-compliance-tests.yml -> deploy-docs.yml)
testing/*/report/

# CI checks proxy-smart/proxy-smart-admin-ui out here to build webapp-dist/.
/admin-ui/

# npm/bun registry auth: GitHub Packages docs tell you to write _authToken here.
.npmrc
