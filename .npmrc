# @max-health-inc packages live in GitHub Packages, not the public registry.
#
# Only OPTIONAL dependencies are resolved from here (see backend/package.json).
# A clone without a GITHUB_TOKEN — which is every open-source clone — installs
# without them, and the routes that need them report themselves unconfigured.
@max-health-inc:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
