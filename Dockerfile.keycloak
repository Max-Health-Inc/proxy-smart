FROM quay.io/keycloak/keycloak:26.6.4

# Copy realm export — environment-specific (deploy/<env>/realm-export.json)
# Falls back to keycloak/realm-export.json (dev/CI) if deploy env file missing.
ARG DEPLOY_ENV=dev
COPY keycloak/realm-export.json /opt/keycloak/data/import/realm-export.json
COPY deploy/${DEPLOY_ENV}/realm-export.jso[n] /opt/keycloak/data/import/

# Copy custom login theme (IdP button icons, branding overrides)
COPY keycloak/themes/proxy-smart /opt/keycloak/themes/proxy-smart

# Set environment variables for production operation
ENV KEYCLOAK_ADMIN=admin
ENV KC_DB=postgres
ENV KC_PROXY_HEADERS=xforwarded
ENV KC_HTTP_ENABLED=true
ENV KC_HOSTNAME_STRICT=false
ENV KC_HEALTH_ENABLED=true
ENV KC_METRICS_ENABLED=true

# Limit JVM heap at runtime (prevents OOM on small VPS instances)
ENV JAVA_OPTS_KC_HEAP="-Xms128m -Xmx512m"

# Build Keycloak to optimize startup time
# JAVA_TOOL_OPTIONS is read by the JVM itself, ensuring kc.sh build respects the heap limit
#
# Feature status verified against Keycloak 26.6.4 Profile.java (authoritative).
# Only features that are NOT enabled-by-default need to be listed here; --features
# ADDS to the default set, it does not replace it.
#
# Explicitly enabled (still EXPERIMENTAL in 26.7):
#   cimd                — OAuth Client ID Metadata Document for MCP 2025-11-25 client registration
#   resource-indicators — RFC 8707 Resource Indicators; binds the access-token aud to the
#       requested FHIR/MCP resource so SMART + MCP audience validation is fail-closed-safe.
#       Needs an audience mapper to keep aud non-null. NOTE: still EXPERIMENTAL in 26.7
#       (did NOT graduate — do not assume otherwise).
#
# On-by-default in 26.7 (previously listed here, now removed as redundant/deprecated):
#   token-exchange-standard:v2 (DEFAULT) — RFC 8693 Standard Token Exchange (required for SHL).
#       The old preview `token-exchange` flag is deprecated; standard TX is now default-on.
#   client-auth-federated (DEFAULT)      — Federated JWT client auth (proxy assertion validation).
#   organization (DEFAULT)               — enabled at runtime via realm attribute (see init.ts).
#
# --http-relative-path must match the runtime KC_HTTP_RELATIVE_PATH from docker-compose,
# otherwise KC detects config drift and re-builds WITHOUT features, causing realm import crash.
RUN JAVA_TOOL_OPTIONS="-Xmx512m" /opt/keycloak/bin/kc.sh build \
    --features=cimd,resource-indicators \
    --http-relative-path=/auth

# Start Keycloak in production mode with realm import and optimized settings.
# --optimized tells KC to use the pre-built config from `kc.sh build` above,
# preventing a re-build that would strip the --features flag.
#
# ENTRYPOINT is the binary ONLY; the arguments live in CMD. That split matters:
# Docker APPENDS CMD to an exec-form ENTRYPOINT, and ECS task definitions set
# `command`, which replaces CMD. With the arguments baked into ENTRYPOINT, an
# ECS `command: ["start","--optimized"]` produced
#     kc.sh start --optimized --import-realm start --optimized
# which Keycloak rejects. Keeping args in CMD lets any runtime override them
# cleanly, and callers that override MUST pass --import-realm themselves (the
# ECS task definition in deploy/infra/lib/keycloak-stack.ts does).
ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
CMD ["start", "--optimized", "--import-realm"]
